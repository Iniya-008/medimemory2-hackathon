+        <div className="flex items-start gap-3">
+          {a.type === "refusal" ? <ShieldAlert className="mt-0.5 h-6 w-6 shrink-0 text-amber-600" /> : <FileText className="mt-0.5 h-6 w-6 shrink-0 text-muted" />}
+          <div className="flex-1">
+            <p className="text-[16px] text-ink">{a.message}</p>
+            <div className="mt-2 flex flex-wrap items-center gap-2">
+              <PlayBtn path={phrasePath(a.phrase, lang)} clips={clips} label={lang === "ta" ? "கேளுங்கள்" : "Hear it"} />
+              {!a.message_verified && <span className="chip bg-amber-50 text-amber-700">Tamil wording not yet checked by a native speaker</span>}
+            </div>
+          </div>
+        </div>
+      </Bubble>
