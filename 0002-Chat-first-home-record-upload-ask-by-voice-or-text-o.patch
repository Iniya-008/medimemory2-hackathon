+              </div>
+              {open[i.id] && (
+                <p className="mt-1.5 rounded-lg bg-canvas px-3 py-2 text-xs text-muted sm:ml-[84px]">
+                  “{i.source_sentence || i.simple_text}”{lang !== "en" && <><br /><span className="font-semibold">In simple English:</span> {i.simple_text}</>}
