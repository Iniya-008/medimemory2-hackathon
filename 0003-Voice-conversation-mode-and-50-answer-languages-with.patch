+
+  useEffect(() => {
+    alive.current = true;
+    (async () => {
+      try {
+        stream.current = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });
+      } catch (e) {
